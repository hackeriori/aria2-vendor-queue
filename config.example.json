{
  "rpc": "https://aria2.example.com/jsonrpc",
  "secret": "",
  "secretEnv": "ARIA2_RPC_SECRET",
  "pollIntervalSec": 3,
  "logFile": "logs/vendor-queue.log",
  "logMaxBytes": 10485760,
  "logRetentionDays": 30,
  "autoAdjustGlobalLimit": true,
  "defaultCategory": "默认",
  "defaultMaxConcurrent": 1,
  "categories": [
    { "name": "夸克", "match": ["/d/夸克/", "/p/夸克/"], "maxConcurrent": 1 },
    { "name": "百度网盘", "match": ["/d/百度网盘/", "/p/百度网盘/"], "maxConcurrent": 1 },
    { "name": "迅雷云盘", "match": ["/d/迅雷云盘/", "/p/迅雷云盘/"], "maxConcurrent": 1 },
    { "name": "阿里云", "match": ["/d/阿里云/", "/p/阿里云/"], "maxConcurrent": 1 },
    { "name": "天翼云盘", "match": ["/d/天翼云盘客户端/", "/p/天翼云盘客户端/"], "maxConcurrent": 1 }
  ],
  "quark": {
    "enabled": false,
    "cookie": "",
    "cookieEnv": "QUARK_COOKIE",
    "pollIntervalSec": 60,
    "dryRun": false,
    "reserveGB": 4,
    "maxSavedEpisodes": 2,
    "deleteAfterDone": true,
    "maxRetries": 6,
    "alistMountPath": "/夸克",
    "stateFile": "state/quark-window.json",
    "alist": {
      "baseUrl": "http://alist:5244",
      "username": "admin",
      "password": ""
    },
    "jobs": [
      {
        "name": "示例-剧集S2",
        "type": "share",
        "shareUrl": "https://pan.quark.cn/s/xxxxxxxxxxxx",
        "include": ["S2"],
        "saveDir": "来自：分享/_pipe/S2",
        "localDir": "/downloads/示例/S02",
        "enabled": false
      },
      {
        "name": "示例-只回收已下完",
        "type": "reclaim",
        "quarkDir": "来自：分享/4K",
        "localDir": "/downloads/谷雨",
        "enabled": false
      }
    ]
  }
}
